<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RitsukageGif.Diagnostics/RitsukageGif.Diagnostics.csproj" />
    <ProjectReference Include="../RitsukageGif.Scripting/RitsukageGif.Scripting.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ScriptMetadataCatalog)' != ''">
    <EmbeddedResource Include="$(ScriptMetadataCatalog)" LogicalName="RitsukageGif.ScriptMetadata.json" />
  </ItemGroup>
  <Target Name="RequireScriptMetadataCatalog" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(ScriptMetadataCatalog)' == '' Or !Exists('$(ScriptMetadataCatalog)')"
           Text="Publish requires ScriptMetadataCatalog exported from the matching desktop automation bindings." />
  </Target>
</Project>
