<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyTitle>RitsukageGif</AssemblyTitle>
    <Product>RitsukageGif</Product>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <SelfContained>true</SelfContained>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../RitsukageGif.Diagnostics/RitsukageGif.Diagnostics.csproj" />
    <ProjectReference Include="../RitsukageGif.SettingsGenerator/RitsukageGif.SettingsGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
    <ProjectReference Include="../RitsukageGif.IconGenerator/RitsukageGif.IconGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
    <AdditionalFiles Include="Assets/Icons/**/*.svg" />
    <Compile Include="Desktop/**/*.cs" />
    <PackageReference Include="JAJ.Packages.MiniAudioEx" Version="3.3.7" />
    <ProjectReference Include="../RitsukageGif.Scripting/RitsukageGif.Scripting.csproj" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <ProjectReference Include="../RitsukageGif.Core/RitsukageGif.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Native" Version="12.1.4" ExcludeAssets="all" />
    <ProjectReference Include="../RitsukageGif.Avalonia.Native/Avalonia.Native.Patched.csproj" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.4" ExcludeAssets="all" />
    <PackageReference Include="Avalonia.X11" Version="12.1.4" ExcludeAssets="all" />
    <ProjectReference Include="../RitsukageGif.Avalonia.Win32/Avalonia.Win32.Patched.csproj" />
    <ProjectReference Include="../RitsukageGif.Avalonia.X11/Avalonia.X11.Patched.csproj" />
    <ProjectReference Include="../RitsukageGif.DragPreview/RitsukageGif.DragPreview.csproj" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.3" />
    <EmbeddedResource Include="About.md" LogicalName="RitsukageGif.About.md" />
    <AvaloniaResource Include="Background.png" />
    <None Include="sounds/screenshot.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES/Fluent-System-Icons.txt"
          Link="THIRD-PARTY-NOTICES/Fluent-System-Icons.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES/Logging.txt"
          Link="THIRD-PARTY-NOTICES/Logging.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES/HtmlAgilityPack.txt"
          Link="THIRD-PARTY-NOTICES/HtmlAgilityPack.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES/CSharpMath.txt"
          Link="THIRD-PARTY-NOTICES/CSharpMath.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
