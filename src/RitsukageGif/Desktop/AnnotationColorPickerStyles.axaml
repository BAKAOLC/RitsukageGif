<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:RitsukageGif.Desktop"
        x:Class="RitsukageGif.Desktop.AnnotationColorPickerStyles">
  <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
  <Style Selector="ColorPicker">
    <Setter Property="Content">
      <Template>
        <Panel>
          <Border Background="{DynamicResource ColorControlCheckeredBackgroundBrush}" />
          <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
          <Border Background="{TemplateBinding HsvColor, Converter={StaticResource ToBrushConverter}}" />
          <Border BorderBrush="{DynamicResource DropDownChevronBrush}" BorderThickness="1" />
        </Panel>
      </Template>
    </Setter>
  </Style>
  <Style Selector="ColorPicker /template/ DropDownButton">
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="DropDownButton">
        <Border Name="PART_Background"
                Padding="4"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="*,16" ColumnSpacing="4">
            <ContentPresenter Name="PART_ContentPresenter"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" />
            <PathIcon Name="DropDownGlyph" Grid.Column="1"
                      Data="{x:Static local:DropDownChevron.Data}"
                      Template="{x:Static local:DropDownChevron.Template}"
                      Width="16" Height="16" MinWidth="0" MinHeight="0"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="{Binding #PART_ContentPresenter.Foreground}"
                      IsHitTestVisible="False" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
