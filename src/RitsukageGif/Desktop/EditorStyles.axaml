<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editing="using:AvaloniaEdit.Editing"
        x:Class="RitsukageGif.Desktop.EditorStyles">
  <Styles.Resources>
    <ResourceDictionary>
      <x:Double x:Key="SearchPanelFontSize">13</x:Double>
      <FontFamily x:Key="SearchPanelFontFamily">Default</FontFamily>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <StaticResource x:Key="CompletionToolTipBackground" ResourceKey="ToolTipBackground" />
          <StaticResource x:Key="CompletionToolTipForeground" ResourceKey="ToolTipForeground" />
          <StaticResource x:Key="CompletionToolTipBorderBrush" ResourceKey="ToolTipBorderBrush" />
          <StaticResource x:Key="OverloadViewerBackground" ResourceKey="ToolTipBackground" />
          <StaticResource x:Key="OverloadViewerForeground" ResourceKey="ToolTipForeground" />
          <StaticResource x:Key="OverloadViewerBorderBrush" ResourceKey="ToolTipBorderBrush" />
          <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
          <StaticResource x:Key="SearchPanelBackgroundBrush" ResourceKey="SemiColorFill0" />
          <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
          <StaticResource x:Key="SearchPanelBorderBrush" ResourceKey="SemiColorPrimary" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <StaticResource x:Key="CompletionToolTipBackground" ResourceKey="ToolTipBackground" />
          <StaticResource x:Key="CompletionToolTipForeground" ResourceKey="ToolTipForeground" />
          <StaticResource x:Key="CompletionToolTipBorderBrush" ResourceKey="ToolTipBorderBrush" />
          <StaticResource x:Key="OverloadViewerBackground" ResourceKey="ToolTipBackground" />
          <StaticResource x:Key="OverloadViewerForeground" ResourceKey="ToolTipForeground" />
          <StaticResource x:Key="OverloadViewerBorderBrush" ResourceKey="ToolTipBorderBrush" />
          <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
          <StaticResource x:Key="SearchPanelBackgroundBrush" ResourceKey="SemiColorFill0" />
          <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
          <StaticResource x:Key="SearchPanelBorderBrush" ResourceKey="SemiColorPrimary" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
      <StaticResource x:Key="CompletionToolTipBorderThickness" ResourceKey="ToolTipBorderThickness" />
      <!-- SemiTheme supplies this resource in App.Initialize before EditorStyles is loaded. -->
      <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
      <StaticResource x:Key="TextAreaSelectionBrush" ResourceKey="TextBoxSelectionBackground" />
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AvaloniaEdit/Themes/Base.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="editing|TextArea">
    <Setter Property="SelectionForeground" Value="{DynamicResource TextBoxSelectionForeground}" />
  </Style>
</Styles>
