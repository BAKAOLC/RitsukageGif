set(telepen_source "${zxing_SOURCE_DIR}/core/src/oned/ODTelepenReader.cpp")
file(READ "${telepen_source}" telepen_original)
set(original_count "std::ranges::count(ba, false)")
set(typed_count "std::ranges::count(ba, uint8_t{0})")
string(FIND "${telepen_original}" "${original_count}" original_position)
if(NOT original_position EQUAL -1)
    string(REPLACE "${original_count}" "${typed_count}" telepen_patched "${telepen_original}")
    file(WRITE "${telepen_source}" "${telepen_patched}")
else()
    string(FIND "${telepen_original}" "${typed_count}" patched_position)
    if(patched_position EQUAL -1)
        message(FATAL_ERROR "The pinned Telepen byte-count patch context has changed.")
    endif()
endif()

set(qr_detector_source "${zxing_SOURCE_DIR}/core/src/qrcode/QRDetector.cpp")
file(READ "${qr_detector_source}" qr_detector_original)
set(original_candidate_limit "const size_t setSizeLimit = 256;")
set(adaptive_candidate_limit "const size_t setSizeLimit = std::max<size_t>(256, patterns.size());")
string(FIND "${qr_detector_original}" "${original_candidate_limit}" original_candidate_position)
if(NOT original_candidate_position EQUAL -1)
    # Scale capacity with detected finder patterns while retaining linear storage.
    string(REPLACE "${original_candidate_limit}" "${adaptive_candidate_limit}"
        qr_detector_patched "${qr_detector_original}")
    file(WRITE "${qr_detector_source}" "${qr_detector_patched}")
else()
    string(FIND "${qr_detector_original}" "${adaptive_candidate_limit}" patched_candidate_position)
    if(patched_candidate_position EQUAL -1)
        message(FATAL_ERROR "The pinned QR candidate-capacity patch context has changed.")
    endif()
endif()
