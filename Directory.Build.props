<Project>
  <PropertyGroup>
    <Authors>OLC</Authors>
    <Company>OLC</Company>
    <Version>1.1.4.0</Version>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <FileVersion>1.1.4.0</FileVersion>
    <InformationalVersion>1.1.4.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RG_BUILD_VERSION)' != ''">
    <Version>$(RG_BUILD_VERSION)</Version>
    <InformationalVersion>$(RG_BUILD_VERSION)</InformationalVersion>
  </PropertyGroup>
</Project>
