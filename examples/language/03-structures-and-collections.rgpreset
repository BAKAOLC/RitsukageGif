preset "解构切片与集合" {
    // 此范例只运行脚本，不启动录制。
    area screen(0, 0, 1, 1);
    script {
        let x = 10;
        const original = {x, y: 20, label: 'A'};
        const changed = {...original, x: 30};
        changed['y'] = 40;
        assert(original.x == 10 && changed.x == 30 && changed.y == 40);
        let [first, , third = 9, ...tail] = [1, 2];
        let {x: left, z = 0, ...extra} = original;
        assert(first == 1 && third == 9 && tail.length == 0);
        assert(left == 10 && z == 0 && extra.label == 'A');
        let right = 0;
        [left, right] = [4, 5];
        ({x: left} = {x: 6});
        assert(left == 6 && right == 5);

        const values = [0, 1, 2, 3, 4];
        assert(values[1:4].join(',') == '1,2,3');
        assert(values[::2].join(',') == '0,2,4');
        assert(values[::-1].join(',') == '4,3,2,1,0');
        assert('hello'[-2:] == 'lo' && 'abcd'[::-1] == 'dcba');
        assert([...values[:2], 9].join(',') == '0,1,9');
        const selected = values.map(n => n * 2).filter(n => n > 2);
        assert(selected.reduce((sum, n) => sum + n, 0) == 18);
        assert(values.some(n => n == 3) && values.every(n => n >= 0));
        assert(values.find(n => n > 2) == 3 && values.findIndex(n => n == 4) == 4);
        let count = 0;
        values.forEach(n => { count += n; });
        assert(count == 10);
        const mutable = [1, 2];
        mutable.push(3);
        assert(mutable.pop() == 3 && mutable.shift() == 1);
        mutable.unshift(9);
        mutable.reverse();
        assert(mutable.join(',') == '2,9' && mutable.concat([10]).length == 3);
        assert(mutable.includes(9) && mutable.indexOf(9) == 1);

        const data = {a: 1, b: 2};
        let sum = 0;
        for (const [key, number] of data.entries()) sum += number;
        assert(sum == 3 && data.keys().length == 2 && data.values().length == 2);
        assert(data.has('a') && data.delete('a') && !data.has('a'));
        const lookup: Map = Map([['main', 1]]);
        lookup.set('preview', 2);
        assert(lookup.get('preview') == 2 && lookup.has('main') && lookup.size == 2);
        assert(lookup.entries().length == 2 && lookup.values().length == 2);
        assert(lookup.delete('main') && lookup.keys()[0] == 'preview');
        lookup.clear();
        assert(lookup.size == 0);
        const unique: Set = Set([1, 1, 2]);
        unique.add(3);
        assert(unique.size == 3 && unique.has(2) && unique.delete(1));
        assert(unique.values().length == 2);
        unique.clear();
        assert(unique.size == 0);

        assert(' a,b '.trim().split(',').join('-') == 'a-b');
        assert('aa'.replace('a', 'b') == 'ba' && 'aa'.replaceAll('a', 'b') == 'bb');
        assert('ab'.repeat(2) == 'abab');
        assert(math.clamp(number('12'), 0, 10) == 10 && math.max(1, 4, 2) == 4);
        print('解构切片与集合：全部通过');
    }
}
